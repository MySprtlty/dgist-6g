# dgist-6g defaults. Edit AERIAL_SDK_DIR for your host; everything else works as is.
# (docker compose reads this file; the entrypoints receive every variable through env_file.)

# ---- host paths / image
AERIAL_SDK_DIR=/home/troy/build/aerial-cuda-accelerated-ran        # Aerial 25-3 SDK checkout (the patch set is applied there by scripts/apply_overlay.sh)
AERIAL_IMAGE=nvcr.io/nvidia/aerial/aerial-cuda-accelerated-ran:25-3-cubb
BUILD_DIR=build.aarch64_dgist                                       # build directory inside the SDK checkout (scripts/build.sh)

# ---- mode: demo = L1 + dApp with the real RU (Benetel), OAI gNB/MAC and core started outside (README);
#            loopback = + RU emulator + testMAC inside this compose (--profile loopback)
MODE=demo
L1_CONFIG=dgist            # demo: configs/demo/cuphycontroller_<L1_CONFIG>.yaml (+ l2_adapter_<L1_CONFIG>.yaml) -> cuphycontroller_scf <L1_CONFIG>
NCELLS=1                   # loopback: emulator cells
PATTERN_MODE=average       # loopback: traffic pattern ddddddsuuu_average | ddddddsuuu_peak
SLOTS=2400000              # loopback: traffic length in slots of 0.5 ms (2400000 = 20 min)
DU_ETH0=aerial02           # loopback: DU-side NIC (setup1_DU.sh)
RU_ETH0=aerial03           # loopback: RU-emulator NIC (setup2_RU.sh)

# ---- dApp: per-slot cuPHY partitions (SM counts of the PUSCH / PDSCH profiles the sizer may choose; the largest replaces the yaml value)
DAPP_PUSCH_PROFILES=16,24,32,40,56
DAPP_PDSCH_PROFILES=24,40
DAPP_SIZER_MODEL=/opt/nvidia/cuBB/cuPHY-CP/dapp_hook/estimator/sm_model.txt

# ---- dApp: YOLO tenant (SM partition = union of 8-SM groups disjoint from everything cuPHY may run)
DAPP_TENANT_CLASSES=40,48,56,64,72,80,88,96,104,112,120   # engine classes (SM counts) the tenant may use; classes without an engine file are skipped
DAPP_TENANT_FB_GUARD=0     # PUSCH fallback profiles kept free above the chosen one (0 -> 80 SMs at 1 cell, 1 -> 72/56)
DAPP_TENANT_LAYOUT=union
DAPP_TENANT_CPU=45         # isolated cores: tenant thread, agent thread, FAPI export thread
DAPP_AGENT_CPU=46
DAPP_AGENT_GRAPH_CHUNK=3   # CUDA-graph nodes per launched piece (bounds the GPU work queued ahead of cuPHY's streams)
DAPP_AGENT_CHUNK_AHEAD=2   # pieces queued ahead
DAPP_AGENT_QOS=1           # refuse a request whose estimate exceeds its qos.deadline_ms
DAPP_AGENT_PORT=9810       # xApp interface (TCP, JSON lines)
DAPP_AGENT_UDP=            # optional host:port that also receives every per-slot estimate as a UDP datagram
# DAPP_TENANT_MODELS=26n=/opt/nvidia/cuBB/cuPHY-CP/dapp_hook/models/full26n,...   (default: models/full26<n|s|m|l|x>)

# ---- xApp stand-ins (--profile xapp)
RA_RATE=4
RA_DURATION=600
RA_POLICY=map              # map = largest model whose estimate meets the deadline; fixed:26m etc. forces a model
RA_DEADLINE_MS=36
RA_IMAGES=/opt/nvidia/cuBB/cuPHY-CP/dapp_hook/models/img4k
SLICING_PERIOD_MS=1000
